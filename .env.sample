# -----------------------------------------------------------------------------
# Application configuration
# -----------------------------------------------------------------------------

# Required lowercase deployment name (3-42 characters: letters, numbers, and
# internal hyphens). Initialization combines it with --env to create simple,
# isolated resource names without asking for bucket or Worker names:
#   <name>-<environment>
#   <name>-<environment>-snapshots
#   <name>-<environment>-assets
DEPLOYMENT_NAME=replace-with-deployment-name

# R2 jurisdiction: default, eu, or fedramp.
R2_BUCKET_JURISDICTION=default

# Public Turnstile site key.
# Get it from: Cloudflare Dashboard > Turnstile > select the application widget
# > copy "Site Key". This value is safe to expose to the browser.
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# SECRET: signs board sessions and capability grants.
# Generate a new value for every environment with: openssl rand -base64 32
# Put the real value in the local/CI secret store, never in a committed file.
SESSION_SIGNING_KEY_CURRENT=replace-with-random-signing-key

# Optional previous signing key used only during a controlled rotation window.
# Leave unset for a fresh installation. Never reuse a key between environments.
SESSION_SIGNING_KEY_PREVIOUS=

# SECRET JSON registry shared only by this Worker and trusted organisation
# backends. Each organisation has a stable derivation key and independently
# rotatable launch-signing keys. See how_to_embed_me.md.
# Generate every key value independently with: openssl rand -base64 32
ORGANISATION_SIGNING_KEYS=replace-with-organisation-signing-key-registry-json

# Public hostname only: no scheme, path, query, or trailing slash.
# The value must also be present in the matching Turnstile widget hostname list
# whenever TURNSTILE_ENABLED is true.
APP_HOSTNAME=replace-with-app-hostname

# Comma-separated exact HTTPS origins that may embed `/embed` (no paths).
# Blank or absent denies all iframe parents. A literal `*` allows every parent;
# use that explicit opt-in only when unrestricted embedding is intentional.
ALLOWED_ORIGINS=

# Comma-separated exact public HTTPS origins approved to receive attributed
# Space exports by webhook. Blank or absent denies webhook configuration and
# delivery. Wildcards are intentionally unsupported because payloads can
# contain participant identifiers and board content.
WEBHOOK_ALLOWED_ORIGINS=

# Public operational switch. Set false to stop new board creation while keeping
# existing board read/reconnect/export routes available.
BOARD_CREATION_ENABLED=true

# Set false for development/staging environments without Turnstile.
TURNSTILE_ENABLED=true

# -----------------------------------------------------------------------------
# Cloudflare provisioning and deployment credentials
# -----------------------------------------------------------------------------

# Cloudflare account ID. It is not cryptographically secret, but keeping it in
# the CI secret group is acceptable. Find it in Cloudflare Dashboard > select
# the account > Account home/Overview > copy "Account ID".
CLOUDFLARE_ACCOUNT_ID=replace-with-32-character-account-id

# SECRET: standard Cloudflare management API token used by bootstrap and CI.
# This is NOT an R2 S3 Access Key ID or Secret Access Key.
#
# Exact creation steps:
# 1. Cloudflare Dashboard > Manage Account > Account API Tokens.
# 2. Select "Create Token", then "Create Custom Token".
# 3. Add Account > Workers Scripts > Edit (`Workers Scripts Write`).
# 4. Add Account > Workers R2 Storage > Edit
#    (`Workers R2 Storage Write`) so bootstrap can create the R2 buckets.
# 5. Add Zone > Zone > Read (`Zone Read`) so bootstrap can discover the zone
#    that owns APP_HOSTNAME.
# 6. Add Zone > WAF > Edit (`Zone WAF Write`) so bootstrap can create and keep
#    the narrow server-API Super Bot Fight Mode skip rule current.
# 7. Under Account Resources choose Include > the one target Worker account.
# 8. Under Zone Resources choose Include > the zone that owns APP_HOSTNAME.
# 9. Add a TTL and client-IP restriction when the CI egress IP is stable.
# 10. Review, create, copy the token once, and save it only in the secret store.
#
# Automatic bootstrap/deploy uses all four permissions on every run. A separate
# deploy-only workflow that does not invoke bootstrap may retain only Workers
# Scripts: Edit, but it will not provision buckets or repair WAF-rule drift.
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token

# SECRET: Turnstile server-side Siteverify credential.
# Get it from: Cloudflare Dashboard > Turnstile > select the application widget
# > Settings/details > copy "Secret Key". This is not the public Site Key.
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
